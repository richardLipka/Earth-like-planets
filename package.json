{
  "name": "astrometrics-earth-like-planets",
  "private": true,
  "version": "1.0.0",
  "description": "3D Stellar Astrometrics, Exoplanet & Habitable Zone Catalogue, and Relativistic Interstellar Route & Timeline Planner for Hard Sci-Fi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "update-db": "node scripts/updateDatabase.mjs",
    "update-db:check": "node scripts/updateDatabase.mjs --check",
    "update-db:planets": "node scripts/updateDatabase.mjs --planets-only",
    "update-db:scifi": "node scripts/updateDatabase.mjs --scifi-only --force",
    "update-db:voyages": "node scripts/updateDatabase.mjs --voyages-only",
    "update-db:offline": "node scripts/updateDatabase.mjs --offline",
    "update-db:force": "node scripts/updateDatabase.mjs --force --backup",
    "data": "node scripts/updateDatabase.mjs",
    "data:refresh": "node scripts/updateDatabase.mjs --force",
    "scifi": "node scripts/buildSciFiSweep.mjs",
    "voyages": "node scripts/buildSciFiVoyages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}

